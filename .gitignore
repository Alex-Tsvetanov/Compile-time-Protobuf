# Clangd artifacts
.cache/
# Build artifacts
build/
build-*/
out/
*.o
*.obj
*.a
*.so
*.dylib
*.dll
*.exe
ctpb.tag

# LaTeX
*.aux
*.log

# Measurement logs are records, not build noise. The bare *.log above is a LaTeX
# rule and it silently ate 211 logs in paper-io-portability and a cited build.log in
# paper-quic-cid-routing -- ignored files never show in git status, so the loss was
# invisible for days. This negation is scoped to measurements/ and cannot affect any
# LaTeX build directory.
!measurements/**/*.log
*.toc
*.bbl
*.blg
*.out
*.fls
*.fdb_latexmk
*.synctex.gz
*.snm
*.nav
*.vrb

# Editor
.vscode/
.idea/
*.swp
.DS_Store

# Generated
*.pb.h
*.pb.cc
paper/docx_preview.pdf
paper/tpl_unpack/
