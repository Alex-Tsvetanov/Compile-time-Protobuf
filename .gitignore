# Clangd artifacts
.cache/
# Build artifacts
build/
build-*/
out/
*.o
*.obj
*.a
*.so
*.dylib
*.dll
*.exe
ctpb.tag

# LaTeX
*.aux
*.log

# Measurement logs are records, not build noise. The bare *.log above is a LaTeX
# rule and it silently ate 211 logs in paper-io-portability and a cited build.log in
# paper-quic-cid-routing -- ignored files never show in git status, so the loss was
# invisible for days. This negation is scoped to measurements/ and cannot affect any
# LaTeX build directory.
!measurements/**/*.log
*.toc
*.bbl
*.blg
*.out
*.fls
*.fdb_latexmk
*.synctex.gz
*.snm
*.nav
*.vrb

# Editor
.vscode/
.idea/
*.swp
.DS_Store

# Generated
*.pb.h
*.pb.cc
paper/docx_preview.pdf
paper/tpl_unpack/

# Everything under measurements/ is a record, whatever its extension. This negation
# MUST be the last rule in this file: gitignore applies the last match, so a bare
# extension rule below it (e.g. *.out) silently re-ignores records. Measured, not
# assumed: with the narrow form above and *.out later, a .out under measurements/ was
# dropped and four raw outputs of the P5 decode experiments were lost that way.
# Verified: no build writes into measurements/ in this repository.
!measurements/**
